<%@ Master Language="C#" MasterPageFile="~/MasterPages/Site.Master" AutoEventWireup="true" CodeBehind="AdminMaster.master.cs" Inherits="binary.MasterPages.AdminMaster" %>
<%@ Register Src="~/Controls/NotificationBell.ascx" TagPrefix="bn" TagName="NotificationBell" %>

<asp:Content ID="AdminBodyContent" ContentPlaceHolderID="MainContent" runat="server">

    <div class="admin-shell">
        <%-- Vertical Left Navigation Sidebar --%>
        <aside class="admin-sidebar">
            <div>
                <a class="admin-sidebar-header" runat="server" href="~/Admin/Default.aspx" style="text-decoration:none;color:inherit;">
                    <div class="admin-logo-mark">Bn</div>
                    <div>
                        <div class="admin-brand-title">Binary Control</div>
                        <span class="admin-badge">Admin Panel</span>
                    </div>
                </a>

                <nav class="admin-sidebar-nav">
                    <div class="admin-nav-group">
                        <div class="admin-nav-group-title">Main Menu</div>
                        <a class="admin-nav-item <%= GetActiveClass("~/Admin/Default.aspx") %>" href="<%= Page.ResolveUrl("~/Admin/Default.aspx") %>">
                            <span class="admin-nav-icon">
                                <svg class="admin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"></rect><rect x="14" y="3" width="7" height="5" rx="1.5"></rect><rect x="14" y="12" width="7" height="9" rx="1.5"></rect><rect x="3" y="16" width="7" height="5" rx="1.5"></rect></svg>
                            </span>
                            <span>Dashboard</span>
                        </a>
                        <a class="admin-nav-item <%= GetActiveClass("~/Admin/Languages.aspx") %>" href="<%= Page.ResolveUrl("~/Admin/Languages.aspx") %>">
                            <span class="admin-nav-icon">
                                <svg class="admin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3c2.5 2.7 2.5 15.3 0 18"></path><path d="M12 3c-2.5 2.7-2.5 15.3 0 18"></path></svg>
                            </span>
                            <span>Languages</span>
                        </a>
                        <a class="admin-nav-item <%= GetActiveClass("~/Admin/Courses.aspx") %>" href="<%= Page.ResolveUrl("~/Admin/Courses.aspx") %>">
                            <span class="admin-nav-icon">
                                <svg class="admin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4.5h6a4 4 0 0 1 4 4v11a3 3 0 0 0-3-3H2z"></path><path d="M22 4.5h-6a4 4 0 0 0-4 4v11a3 3 0 0 1 3-3h7z"></path></svg>
                            </span>
                            <span>Courses & Lessons</span>
                        </a>
                        <a class="admin-nav-item <%= GetActiveClass("~/Admin/Users.aspx") %>" href="<%= Page.ResolveUrl("~/Admin/Users.aspx") %>">
                            <span class="admin-nav-icon">
                                <svg class="admin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                            </span>
                            <span>Users</span>
                        </a>
                    </div>

                    <div class="admin-nav-group">
                        <div class="admin-nav-group-title">Analytics</div>
                        <a class="admin-nav-item <%= GetActiveClass("~/Admin/Reports.aspx") %>" href="<%= Page.ResolveUrl("~/Admin/Reports.aspx") %>">
                            <span class="admin-nav-icon">
                                <svg class="admin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                            </span>
                            <span>Reports</span>
                        </a>
                    </div>

                    <div class="admin-nav-group">
                        <div class="admin-nav-group-title">Settings</div>
                        <a class="admin-nav-item <%= GetActiveClass("~/Admin/Feedback.aspx") %>" href="<%= Page.ResolveUrl("~/Admin/Feedback.aspx") %>">
                            <span class="admin-nav-icon">
                                <svg class="admin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11Z"></path></svg>
                            </span>
                            <span>Feedback</span>
                        </a>
                    </div>
                </nav>
            </div>

            <%-- Admin User Profile Footer --%>
            <div class="admin-sidebar-footer">
                <a class="admin-user-info" runat="server" href="~/Users/Profile.aspx?tab=profile" style="text-decoration:none;color:inherit;" title="Edit your profile">
                    <div class="admin-user-avatar"><%= GetAvatarHtml() %></div>
                    <div class="admin-user-meta">
                        <div class="admin-user-name"><%: AdminName %></div>
                        <div class="admin-user-role"><%: AdminEmail %></div>
                    </div>
                </a>
                <a class="admin-logout-btn" runat="server" href="~/Auth/Logout.aspx" title="Sign Out">
                    <svg class="admin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                </a>
            </div>
        </aside>

        <%-- Main Viewport --%>
        <div class="admin-viewport">
            <header class="admin-global-bar">
                <div class="admin-global-search">
                    <svg class="admin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="search" placeholder="Search…" autocomplete="off" />
                </div>
                <div class="admin-global-actions">
                    <a class="admin-icon-btn" runat="server" href="~/" target="_blank" title="View Site">
                        <svg class="admin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                    </a>
                    <bn:NotificationBell ID="NotificationBell" runat="server" />
                    <a class="admin-global-avatar" runat="server" href="~/Users/Profile.aspx?tab=profile" title="Edit your profile" style="text-decoration:none;color:inherit;"><%= GetAvatarHtml() %></a>
                </div>
            </header>

            <header class="admin-topbar">
                <div>
                    <h1 style="font-size:1.4rem;font-weight:800;letter-spacing:-0.02em;"><asp:ContentPlaceHolder ID="AdminHeaderTitle" runat="server" /></h1>
                    <p style="color:var(--text-muted);font-size:13px;"><asp:ContentPlaceHolder ID="AdminHeaderSubtitle" runat="server" /></p>
                </div>
                <div style="display:flex;gap:var(--space-3);align-items:center;">
                    <asp:ContentPlaceHolder ID="AdminHeaderActions" runat="server" />
                </div>
            </header>

            <main class="admin-content-container">
                <asp:ContentPlaceHolder ID="AdminMainContent" runat="server" />
            </main>
        </div>
    </div>

</asp:Content>
